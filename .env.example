SURREAL_URL=ws://127.0.0.1:8010/rpc
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=refs
SURREAL_DB=main
# Where screenshots and crops are written. Served under /media.
MEDIA_DIR=data/media
# The model service in ml/. The crawler's enrich step and the app's semantic search call it.
