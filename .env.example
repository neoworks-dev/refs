SURREAL_URL=ws://127.0.0.1:8010/rpc
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=refs
SURREAL_DB=main
# Where screenshots and crops are written. Served under /media.
MEDIA_DIR=data/media
# The models, as OpenAI-compatible servers: a RunPod endpoint, or the local ones `cd ml && uv run serve`
# starts. The VLM plans flows, drives the browser and describes screens. The grounding server points
# at elements and defaults to the VLM. The embedder powers semantic search; without its URL nothing
# is embedded and search is off.
REFS_VLM_URL=http://127.0.0.1:8020/v1
REFS_VLM_MODEL=vlm
# REFS_EMBEDDING_URL=http://127.0.0.1:8021/v1
# REFS_EMBEDDING_MODEL=embedder
# REFS_GROUNDING_URL=
# REFS_GROUNDING_MODEL=
# Bearer token for RunPod's endpoints; local servers need none.
REFS_MODEL_API_KEY=
# Keys for the model benchmarks in bench/. OpenRouter serves the planners and the deciders, H Company its
# Holo models.
OPENROUTER_API_KEY=
HCOMPANY_API_KEY=
# Output tokens the flow plan of a site may take. Prompt and output must fit the VLM's context window:
# 10000 fits the local 16k window, a 32k server can take about 24000.
# REFS_PLAN_MAX_TOKENS=10000
# The demo Gmail inbox exploration signs up with, as plus addresses per site, and reads
# verification emails from over IMAP. The password is a Gmail app password, not the account's own.
REFS_MAIL_ADDRESS=
REFS_MAIL_APP_PASSWORD=
